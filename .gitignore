# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js ─────────────────────────────────────────────────────────────────
.next/
out/
build/
coverage/

# ─── Environment — NEVER commit secrets ──────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# .env.example is safe to commit (no real secrets)

# ─── Stellar / Soroban ───────────────────────────────────────────────────────
# Compiled contract artifacts
contracts/target/
# Stellar CLI local identity files (contain secret keys)
.stellar/
*.toml.bak

# ─── Prisma ──────────────────────────────────────────────────────────────────
# Migration lock is safe to commit; generated client is not needed
prisma/generated/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── OS / Editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
.vscode/settings.json
.idea/

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Uploads (local dev only) ────────────────────────────────────────────────
public/uploads/
